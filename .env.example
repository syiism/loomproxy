# LoomProxy 配置示例
# 复制为 .env 并根据需要修改

# ==================== 服务配置 ====================

# 监听地址
SERVER_HOST=0.0.0.0
# 监听端口
SERVER_PORT=8081
# 日志级别：debug / info
SERVER_LOG_LEVEL=info

# ==================== 网络与缓存 ====================

# 上游连接超时（秒）
TIMEOUT_CONNECT=5.0
# 上游读取超时（秒）
TIMEOUT_POOL=10.0
# 缓存 TTL（秒）
CACHE_TTL=300
# LRU 缓存最大条目数
CACHE_MAXSIZE=128
# 上游响应短 TTL 缓存（秒，<=0 禁用；作用于 search/detail/chapter/explore）
UPSTREAM_CACHE_TTL=10
# 上游响应缓存最大条目数
UPSTREAM_CACHE_MAXSIZE=512
# 熔断器开关（按上游 host 维度）
CIRCUIT_BREAKER_ENABLED=true
# 连续失败次数阈值（达到后开启熔断）
CIRCUIT_BREAKER_FAILURES=5
# 熔断冷却时间（秒），期间请求快速失败 503
CIRCUIT_BREAKER_COOLDOWN=30
# User-Agent 轮换（按请求伪装移动端/桌面端指纹）
UPSTREAM_UA_ROTATE=false
# 上游 IP 代理池，逗号分隔（http/socks5，可带 user:pass）
# UPSTREAM_PROXIES=
# 代理列表文件（每行一个，# 注释，5s 热加载），与 UPSTREAM_PROXIES 可叠加
# UPSTREAM_PROXY_FILE=
# 动态代理 API（定时拉取 + 健康校验后入池，返回格式 {"data":{"proxies":["ip:port",...]}}）
# 实测免费代理 HTTP 协议几乎全军覆没，SOCKS5 存活率约 15-20%，建议 protocol=socks5
# UPSTREAM_PROXY_API=https://proxy.scdn.io/api/get_proxy.php?protocol=socks5&count=20&country_code=CN
# API 返回代理的协议（http/socks5，需与 API 的 protocol 参数对应）
# UPSTREAM_PROXY_API_SCHEME=socks5
# 补充间隔秒（默认 120，最小 30）：池水位低于 5 时自动补充（复验存量+逐轮拉新），该值为两次补充的最小间隔
# UPSTREAM_PROXY_API_INTERVAL=120
# 代理健康校验 URL（经代理请求，<400 视为存活；建议设为目标上游）
# UPSTREAM_PROXY_CHECK_URL=https://www.baidu.com

# ==================== 数据目录 ====================

# 数据目录（SQLite、JSON 配置文件等）
DATA_DIR=data
# 数据文件匹配模式
DATA_FILE_GLOB=*.json
# 时区偏移（用于额度重置时间，北京时间=8）
TZ_OFFSET_HOURS=8

# ==================== 错误响应 ====================

# 统一错误码
ERROR_CODE=-1

# ==================== 鉴权配置 ====================

# 开放模式：无需登录，不计费
# 启用模式：JWT + API Key 鉴权，启用额度计费
AUTH_ENABLED=false

# 静态 API Key（逗号分隔），用于服务间调用
API_KEYS=

# 白名单路径（无需鉴权），逗号分隔
AUTH_WHITELIST=/,/data,/auth/register,/auth/login,/panel

# ==================== 数据库配置 ====================

# 支持 sqlite / mysql / postgres
DB_TYPE=sqlite

# MySQL / PostgreSQL 配置（DB_TYPE 非 sqlite 时生效）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=loomproxy
# postgres: disable / require / verify-full
DB_SSLMODE=disable

# ==================== JWT 配置 ====================

# ⚠️ 生产环境必须设置强随机密钥（建议 32+ 字符）
# 开发模式可使用默认值，生产模式若未修改将拒绝启动
JWT_SECRET=loomproxy-default-secret-change-me
# Token 有效期（小时），默认 7 天
JWT_EXPIRE_HOURS=168

# ==================== 管理员引导 ====================

# 首次启动时自动创建管理员账号
# 生产环境建议显式设置；开发环境留空将自动生成随机密码并打印日志
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ==================== 号池（凭证池）====================
# base/pool 通用能力：需要凭证池的数据源在启动时登记自己的池，此处为统一运行参数
# 总开关（false 时不启动任何号池，面板「号池」页只剩库中历史记录）
POOL_ENABLED=true
# 冷备号数量（未领取、不过期，活跃号退役时转正）
POOL_COLD_SPARES=2
# 活跃号上限（平时 1 个，观测到上游限流时错误驱动扩容至此上限）
POOL_MAX_HOT=3
# dead 号保留上限，超出部分物理删除
POOL_MAX_DEAD=10
# 活跃号到期前多少秒续领（要求数据源的领取是叠加无损的）
POOL_RENEW_BEFORE_SEC=300
# 维护协程巡检间隔（秒）
POOL_MAINTAIN_SEC=60

# ==================== 数据源存量清理 ====================
# 本部署已下线的历史数据源码，逗号分隔；启动时清理它们在 data_sources / quota_costs /
# quota_cost_plans / user_quota_overrides / quota_limits / 平台与用户 baseUrl 配置表中
# 的存量行（历史用量流水保留不删）。同时会一并对内置套餐补齐全部存活源的关联。
# 底座不携带数据源实现，故默认留空；由部署侧（携带书源的项目）声明自己的源变迁史。
RETIRED_SOURCES=
