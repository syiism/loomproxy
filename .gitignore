# 环境变量与密钥（含 API_KEYS / ADMIN_PASSWORD / JWT_SECRET）
.env

# Go 构建产物
/loomproxy
/loomproxy-go
/loomproxy-go-release
/web/loomproxy

# 运行时数据（data/ 下各数据源目录的 JSON 配置如需入库，自行加 ! 例外）
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal

# 前端依赖与构建产物（构建顺序见 AGENTS.md：先 pnpm build 再 go build）
web/node_modules/
web/dist/

# 系统与编辑器
.DS_Store
Thumbs.db
*.log

/loomproxy-go-static

# Python 测试
__pycache__/
*.pyc
.pytest_cache/
.venv/
# test/python 是 uv 工程：pytest 环境建在目录内，别把 300MB 落进 git

# GUI 测试临时截图
/gui-test-screenshots/
*.log
tools/migrate-cards/codes.txt
data/state.json

.workbuddy
# 测试服务入口产物（test/python 用）
/loomproxy-fakegateway

# 本地代理工作区（方案与记忆文档，不入库）——`plans/`、`worktrees/` 仍然整目录排除。
# 唯一的例外是会话钩子的项目级配置：它是团队门禁的一部分，不是某个人的本地状态（待办清单 P109）。
# 改成 `.qoder/*` 而不是留 `.qoder/` 是因为**被排除的目录 git 根本不会进去**，写在里面的否定式不生效。
.qoder/*
!.qoder/settings.json
